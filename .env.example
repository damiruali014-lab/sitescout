# ─── SiteScout environment variables ───────────────────────────────
# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.
# Without ANY of these the app still runs in Demo mode (sample data, no login).

# Google Places API (New) — console.cloud.google.com → APIs & Services → enable "Places API (New)"
# → Credentials → Create API key → restrict it to "Places API (New)". Requires a billing account.
# Search uses the Text Search Enterprise SKU: 1,000 free requests/month, then ~$35 per 1,000.
GOOGLE_PLACES_API_KEY=

# 2GIS Catalog API — platform.2gis.ru (Platform Manager) → create a demo key (free, limited).
# Ask 2GIS to enable "contact_groups" on the key, otherwise phones/websites are hidden.
DGIS_API_KEY=

# Anthropic — platform.claude.com → API Keys. Prepaid credits; set a monthly spend limit.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5 (cheapest)
ANTHROPIC_MODEL=

# Instagram bio check (optional) — official Instagram Graph API "Business Discovery".
# Reads the website in a business's Instagram bio. Setup (~20 min, see README → "Instagram check"):
# your own Instagram professional account linked to a Facebook Page + a Meta developer app.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional, defaults to v25.0
IG_GRAPH_VERSION=

# Supabase — Project Settings → API. URL + anon key are public by design (protected by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only! Never prefix with VITE_. Used to serve public demo pages.
SUPABASE_SERVICE_ROLE_KEY=

# Only this email may call the paid /api endpoints.
ALLOWED_EMAIL=

# Local dev only (ignored on Vercel): skip the login check for /api calls.
DEV_SKIP_AUTH=
